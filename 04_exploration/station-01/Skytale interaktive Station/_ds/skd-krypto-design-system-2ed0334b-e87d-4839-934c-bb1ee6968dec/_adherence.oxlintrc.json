{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/exhibition/**",
              "ui_kits/exhibition_station/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Mono|Inter))/i]",
        "message": "Font not provided by the design system. Available: DM Mono, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreAlert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<CoreAlert> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreAlert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|error)$/]",
        "message": "<CoreAlert> tone must be one of 'info' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|type|state|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CoreButton> doesn't accept that prop. Declared props: children, type, state, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreButton'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<CoreButton> type must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|focus|disabled)$/]",
        "message": "<CoreButton> state must be one of 'default' | 'focus' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CoreCard> doesn't accept that prop. Declared props: variant, title, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:static|interactive)$/]",
        "message": "<CoreCard> variant must be one of 'static' | 'interactive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreFormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|hint|error|state|onChange|style|key|ref|className|style|children)$/]",
        "message": "<CoreFormField> doesn't accept that prop. Declared props: label, placeholder, value, hint, error, state, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreFormField'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|focus|error)$/]",
        "message": "<CoreFormField> state must be one of 'default' | 'focus' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|state|style|key|ref|className|style|children)$/]",
        "message": "<CoreLink> doesn't accept that prop. Declared props: children, href, state, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreLink'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|focus)$/]",
        "message": "<CoreLink> state must be one of 'default' | 'focus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeepDiveCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|question|icon|onOpen|width|style|key|ref|className|style|children)$/]",
        "message": "<DeepDiveCard> doesn't accept that prop. Declared props: label, question, icon, onOpen, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EnigmaKey'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|state|onClick|style|key|ref|className|style|children)$/]",
        "message": "<EnigmaKey> doesn't accept that prop. Declared props: letter, state, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EnigmaKey'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|live|active|lit)$/]",
        "message": "<EnigmaKey> state must be one of 'idle' | 'live' | 'active' | 'lit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExhibitButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|variant|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<ExhibitButton> doesn't accept that prop. Declared props: children, tone, variant, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExhibitButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:action|navigation)$/]",
        "message": "<ExhibitButton> tone must be one of 'action' | 'navigation'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExhibitButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary)$/]",
        "message": "<ExhibitButton> variant must be one of 'primary' | 'secondary' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tone|onClick|label|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, size, tone, onClick, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:action|neutral)$/]",
        "message": "<IconButton> tone must be one of 'action' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IOField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|width|style|key|ref|className|style|children)$/]",
        "message": "<IOField> doesn't accept that prop. Declared props: label, value, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RotorDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|width|style|key|ref|className|style|children)$/]",
        "message": "<RotorDisplay> doesn't accept that prop. Declared props: label, value, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|size|style|key|ref|className|style|children)$/]",
        "message": "<ScreenHeader> doesn't accept that prop. Declared props: eyebrow, title, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenHeader'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|h1|h2)$/]",
        "message": "<ScreenHeader> size must be one of 'display' | 'h1' | 'h2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StationTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:station|topic|style|key|ref|className|style|children)$/]",
        "message": "<StationTag> doesn't accept that prop. Declared props: station, topic, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|hairline|children|style|key|ref|className|style|children)$/]",
        "message": "<Surface> doesn't accept that prop. Declared props: level, hairline, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:elevated|contained|subtle)$/]",
        "message": "<Surface> level must be one of 'elevated' | 'contained' | 'subtle'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
